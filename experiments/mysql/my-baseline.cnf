[mysqld]
basedir=/home/ubuntu/metis-mysql-lab/mysql-build-baseline
datadir=/home/ubuntu/metis-mysql-lab/mysql-data-baseline

port=3307
bind-address=127.0.0.1
socket=/home/ubuntu/metis-mysql-lab/run/mysql-baseline.sock
pid-file=/home/ubuntu/metis-mysql-lab/run/mysql-baseline.pid
log-error=/home/ubuntu/metis-mysql-lab/log/mysql-baseline.err

default-storage-engine=InnoDB
max-connections=256
performance-schema=ON

innodb-buffer-pool-size=32G
innodb-flush-log-at-trx-commit=1
sync-binlog=1
skip-log-bin

mysqlx=OFF

[client]
port=3307
host=127.0.0.1
socket=/home/ubuntu/metis-mysql-lab/run/mysql-baseline.sock
